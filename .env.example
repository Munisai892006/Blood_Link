# =====================================================================
# BLOODLINK 3.0 ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Document Version: 1.0 | Date: 23 October 2026
#
# INSTRUCTIONS:
# Copy this file to .env and supply actual deployment values.
# DO NOT commit real secrets or credentials to source control.
# =====================================================================

# Server & Runtime
NODE_ENV=development
PORT=5000
APP_BASE_URL=http://localhost:5000

# Authentication & Security (FR-AUTH-002, NFR-SEC-003)
JWT_SECRET=your_long_random_jwt_secret_change_in_production
JWT_EXPIRY=24h
BCRYPT_SALT_ROUNDS=10

# Database Configuration (PostgreSQL / SQLite)
DATABASE_URL=sqlite:///server/src/db/bloodlink.db
# For production PostgreSQL + PostGIS:
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=bloodlink_prod
# POSTGRES_USER=bloodlink_app
# POSTGRES_PASSWORD=your_secure_db_password

# Asynchronous Worker & Queues (Redis / BullMQ)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Notification Providers (FR-NOT-001, FR-NOT-007)
# Note: Real SMS/Email sending is disabled by default in development and test environments
ENABLE_REAL_NOTIFICATIONS=false
SMS_PROVIDER=mock
SMS_API_KEY=mock_sms_key_placeholder
EMAIL_PROVIDER=mock
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=mock_user
SMTP_PASS=mock_pass
WEB_PUSH_VAPID_PUBLIC_KEY=mock_vapid_public_key
WEB_PUSH_VAPID_PRIVATE_KEY=mock_vapid_private_key

# Geolocation & Maps Provider
MAPS_PROVIDER=mock
MAPS_API_KEY=mock_maps_key_placeholder

# AI Demand Forecasting Module (FR-AI-001)
FORECAST_MODEL_VERSION=2.4.1-rc
FORECAST_CONFIDENCE_LEVEL=0.95

# Audit Logging & Redaction (FR-PRV-003, FR-PRV-004)
LOG_LEVEL=info
REDACT_SENSITIVE_PII=true
